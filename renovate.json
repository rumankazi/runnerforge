{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigestsToSemver", ":semanticCommits"],
  "rebaseWhen": "conflicted",
  "labels": ["deps"],
  "lockFileMaintenance": {
    "enabled": true,
    "autoApprove": true,
    "automerge": true
  },
  "major": {
    "autoApprove": false,
    "addLabels": ["major", "{{depName}}"],
    "dependencyDashboardApproval": true
  },
  "minor": {
    "autoApprove": false,
    "addLabels": ["minor", "{{depName}}"]
  },
  "patch": {
    "autoApprove": true,
    "addLabels": ["patch", "{{depName}}"]
  },
  "packageRules": [
    {
      "groupName": "all minor dependencies",
      "groupSlug": "all-minor",
      "matchPackageNames": ["*"],
      "matchUpdateTypes": "minor"
    },
    {
      "groupName": "all patch dependencies",
      "groupSlug": "all-patch",
      "matchPackageNames": ["*"],
      "matchUpdateTypes": "patch"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["infra/packer/scripts/install-runner.sh"],
      "matchStrings": ["RUNNER_VERSION=\"(?<currentValue>[0-9.]+)\""],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "actions/runner",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    }
  ]
}
