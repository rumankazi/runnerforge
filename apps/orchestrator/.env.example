# shared HMAC key for payload (arrived on webhook) validation [generated using: openssl rand -hex 32]. Stored in Github App and here.
GITHUB_WEBHOOK_SECRET=<webhook-secret>

# Required private key for the JWT creation
# JWT then later be used for exchanging installation token
# Once github app is identified, registration token is created, travels to VM for registration with Github
# for deployment, this would be added as google secret and exposed to cloud run.
GITHUB_APP_PRIVATE_KEY_PATH=<path-to-pem>

# Used for generating JWT
GITHUB_APP_ID=<github-app-id>


# GCP
GCP_PROJECT_ID=<gcp-project-id>
GCP_ZONE=europe-west4-a

# Optional: comma-separated GitHub App installation ids allowed to get VMs.
# Unset = every installation is allowed (fine for a private, self-hosted App).
# Set it whenever the App is public; an empty value allows nobody.
# ALLOWED_INSTALLATION_IDS=<installation-id>,<installation-id>

# Optional: per-job store (ADR-018). "none" (default) writes nothing;
# "firestore" writes job records to the named Firestore database.
# JOB_STORE=none
# FIRESTORE_DATABASE=runnerforge

# Optional: admission (ADR-019). "allowlist" (default) admits by
# ALLOWED_INSTALLATION_IDS alone. "registry" admits listed IDs as unlimited and
# everyone else by their approved tenant-registry row and limits (needs
# JOB_STORE=firestore); an unset list then means nobody, not everyone.
# ADMISSION=allowlist

# Optional: project owning the runner image family (defaults to GCP_PROJECT_ID).
# RUNNER_IMAGE_PROJECT=<gcp-project-id>

# Optional (ADR-020): project the runner VMs are created in (defaults to
# GCP_PROJECT_ID), and the subnetwork they use there, as
# [projects/<project>/]regions/<region of GCP_ZONE>/subnetworks/<name>.
# Empty uses the VM project's default network.
# RUNNER_VM_PROJECT_ID=<gcp-project-id>
# RUNNER_VM_SUBNETWORK=regions/europe-west4/subnetworks/<name>

# Optional: service account attached to the runner VMs. Empty attaches none;
# it must be empty when RUNNER_VM_PROJECT_ID differs from GCP_PROJECT_ID.
RUNNER_VM_SA_EMAIL=runner-vm@<gcp-project-id>.iam.gserviceaccount.com

# Service account expected to call the /sweep endpoint (Cloud Scheduler).
EXPECTED_SCHEDULER_SA_EMAIL=scheduler@<gcp-project-id>.iam.gserviceaccount.com

# Expected OIDC audience for scheduler requests to /sweep.
EXPECTED_AUDIENCE=https://runnerforge.example.com
