# shared HMAC key for payload (arrived on webhook) validation [generated using: openssl rand -hex 32]. Stored in Github App and here.
GITHUB_WEBHOOK_SECRET=<webhook-secret>

# Required private key for the JWT creation
# JWT then later be used for exchanging installation token
# Once github app is identified, registration token is created, travels to VM for registration with Github
# for deployment, this would be added as google secret and exposed to cloud run.
GITHUB_APP_PRIVATE_KEY_PATH=<path-to-pem>

# Used for generating JWT
GITHUB_APP_ID=<github-app-id>


# GCP
GCP_PROJECT_ID=<gcp-project-id>
GCP_ZONE=europe-west4-a

# Optional: project owning the runner image family (defaults to GCP_PROJECT_ID).
# RUNNER_IMAGE_PROJECT=<gcp-project-id>

# Service account used by the GCE runner VMs.
RUNNER_VM_SA_EMAIL=runner-vm@<gcp-project-id>.iam.gserviceaccount.com

# Service account expected to call the /sweep endpoint (Cloud Scheduler).
EXPECTED_SCHEDULER_SA_EMAIL=scheduler@<gcp-project-id>.iam.gserviceaccount.com

# Expected OIDC audience for scheduler requests to /sweep.
EXPECTED_AUDIENCE=https://runnerforge.example.com
