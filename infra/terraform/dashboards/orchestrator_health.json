{
  "displayName": "RunnerForge — Orchestrator Health",
  "mosaicLayout": {
    "columns": 48,
    "tiles": [
      {
        "yPos": 0,
        "xPos": 0,
        "width": 48,
        "height": 4,
        "widget": {
          "title": "Orchestrator Health",
          "sectionHeader": {
            "subtitle": "Service-level health, scaling behavior, and request signals.",
            "dividerBelow": true
          }
        }
      },
      {
        "yPos": 4,
        "xPos": 0,
        "width": 24,
        "height": 16,
        "widget": {
          "title": "Request rate by response_code_class",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "minAlignmentPeriod": "60s",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "metric.label.\"response_code_class\""
                      ],
                      "perSeriesAligner": "ALIGN_RATE"
                    },
                    "filter": "metric.type=\"run.googleapis.com/request_count\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=\"runnerforge-orchestrator\""
                  }
                }
              }
            ],
            "yAxis": {
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "yPos": 4,
        "xPos": 24,
        "width": 24,
        "height": 16,
        "widget": {
          "title": "Request latency p50/p95/p99",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "legendTemplate": "p50",
                "minAlignmentPeriod": "60s",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_MEAN",
                      "perSeriesAligner": "ALIGN_PERCENTILE_50"
                    },
                    "filter": "metric.type=\"run.googleapis.com/request_latencies\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=\"runnerforge-orchestrator\""
                  }
                }
              },
              {
                "legendTemplate": "p95",
                "minAlignmentPeriod": "60s",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_MEAN",
                      "perSeriesAligner": "ALIGN_PERCENTILE_95"
                    },
                    "filter": "metric.type=\"run.googleapis.com/request_latencies\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=\"runnerforge-orchestrator\""
                  }
                }
              },
              {
                "legendTemplate": "p99",
                "minAlignmentPeriod": "60s",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_MEAN",
                      "perSeriesAligner": "ALIGN_PERCENTILE_99"
                    },
                    "filter": "metric.type=\"run.googleapis.com/request_latencies\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=\"runnerforge-orchestrator\""
                  }
                }
              }
            ],
            "yAxis": {
              "label": "ms",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "yPos": 20,
        "xPos": 0,
        "width": 24,
        "height": 16,
        "widget": {
          "title": "Active instances + cold-start p95 by revision",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "legendTemplate": "instances",
                "minAlignmentPeriod": "60s",
                "plotType": "STACKED_AREA",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "resource.label.\"revision_name\""
                      ],
                      "perSeriesAligner": "ALIGN_MEAN"
                    },
                    "filter": "metric.type=\"run.googleapis.com/container/instance_count\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=\"runnerforge-orchestrator\""
                  }
                }
              },
              {
                "legendTemplate": "cold-start p95",
                "minAlignmentPeriod": "60s",
                "plotType": "LINE",
                "targetAxis": "Y2",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_MAX",
                      "groupByFields": [
                        "resource.label.\"revision_name\""
                      ],
                      "perSeriesAligner": "ALIGN_PERCENTILE_95"
                    },
                    "filter": "metric.type=\"run.googleapis.com/container/startup_latencies\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=\"runnerforge-orchestrator\""
                  }
                }
              }
            ],
            "yAxis": {
              "label": "instances",
              "scale": "LINEAR"
            },
            "y2Axis": {
              "label": "cold-start ms",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "yPos": 20,
        "xPos": 24,
        "width": 24,
        "height": 16,
        "widget": {
          "title": "Memory utilization p95 by revision",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "minAlignmentPeriod": "60s",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_MAX",
                      "groupByFields": [
                        "resource.label.\"revision_name\""
                      ],
                      "perSeriesAligner": "ALIGN_PERCENTILE_95"
                    },
                    "filter": "metric.type=\"run.googleapis.com/container/memory/utilizations\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=\"runnerforge-orchestrator\""
                  }
                }
              }
            ],
            "yAxis": {
              "label": "fraction",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "yPos": 36,
        "xPos": 0,
        "width": 48,
        "height": 4,
        "widget": {
          "title": "Runner Fleet",
          "sectionHeader": {
            "subtitle": "VM lifecycle: requested → registered → completed → deleted.",
            "dividerBelow": true
          }
        }
      },
      {
        "yPos": 40,
        "xPos": 0,
        "width": 24,
        "height": 16,
        "widget": {
          "title": "VM creation rate by machine_type",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "minAlignmentPeriod": "60s",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "metric.label.\"machine_type\""
                      ],
                      "perSeriesAligner": "ALIGN_DELTA"
                    },
                    "filter": "metric.type=\"logging.googleapis.com/user/vm_creation_count\" resource.type=\"cloud_run_revision\""
                  }
                }
              }
            ],
            "yAxis": {
              "label": "events/min",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "yPos": 40,
        "xPos": 24,
        "width": 24,
        "height": 16,
        "widget": {
          "title": "VM creation outcomes per minute by outcome",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "minAlignmentPeriod": "60s",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "metric.label.\"outcome\""
                      ],
                      "perSeriesAligner": "ALIGN_DELTA"
                    },
                    "filter": "metric.type=\"logging.googleapis.com/user/vm_creation_outcome_count\" resource.type=\"cloud_run_revision\""
                  }
                }
              }
            ],
            "yAxis": {
              "label": "events/min",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "yPos": 56,
        "xPos": 0,
        "width": 24,
        "height": 16,
        "widget": {
          "title": "VM deletion rate by reason",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "minAlignmentPeriod": "60s",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "metric.label.\"reason\""
                      ],
                      "perSeriesAligner": "ALIGN_DELTA"
                    },
                    "filter": "metric.type=\"logging.googleapis.com/user/vm_deletion_count\" resource.type=\"cloud_run_revision\""
                  }
                }
              }
            ],
            "yAxis": {
              "label": "events/min",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "yPos": 56,
        "xPos": 24,
        "width": 24,
        "height": 16,
        "widget": {
          "title": "Active runner VMs",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "minAlignmentPeriod": "300s",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "300s",
                      "crossSeriesReducer": "REDUCE_MEAN",
                      "perSeriesAligner": "ALIGN_PERCENTILE_50"
                    },
                    "filter": "metric.type=\"logging.googleapis.com/user/runner_vm_count\" resource.type=\"cloud_run_revision\""
                  }
                }
              }
            ],
            "yAxis": {
              "label": "VMs",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "yPos": 72,
        "xPos": 0,
        "width": 48,
        "height": 16,
        "widget": {
          "title": "Time-to-Register p05/p50/p95",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "legendTemplate": "p05 (lower bound)",
                "minAlignmentPeriod": "60s",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_MEAN",
                      "perSeriesAligner": "ALIGN_PERCENTILE_05"
                    },
                    "filter": "metric.type=\"logging.googleapis.com/user/time_to_runner_seconds\" resource.type=\"cloud_run_revision\""
                  }
                }
              },
              {
                "legendTemplate": "p50 (typical)",
                "minAlignmentPeriod": "60s",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_MEAN",
                      "perSeriesAligner": "ALIGN_PERCENTILE_50"
                    },
                    "filter": "metric.type=\"logging.googleapis.com/user/time_to_runner_seconds\" resource.type=\"cloud_run_revision\""
                  }
                }
              },
              {
                "legendTemplate": "p95 (upper bound)",
                "minAlignmentPeriod": "60s",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "crossSeriesReducer": "REDUCE_MEAN",
                      "perSeriesAligner": "ALIGN_PERCENTILE_95"
                    },
                    "filter": "metric.type=\"logging.googleapis.com/user/time_to_runner_seconds\" resource.type=\"cloud_run_revision\""
                  }
                }
              }
            ],
            "yAxis": {
              "label": "s",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "yPos": 88,
        "xPos": 0,
        "width": 48,
        "height": 4,
        "widget": {
          "title": "Sweep & cleanup",
          "sectionHeader": {
            "subtitle": "Hourly orphan-VM safety net. Per-run distributions, ~12 samples/day.",
            "dividerBelow": true
          }
        }
      },
      {
        "yPos": 92,
        "xPos": 0,
        "width": 16,
        "height": 16,
        "widget": {
          "title": "Sweep checked (VMs inspected per run)",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "minAlignmentPeriod": "3600s",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "3600s",
                      "crossSeriesReducer": "REDUCE_MEAN",
                      "perSeriesAligner": "ALIGN_PERCENTILE_50"
                    },
                    "filter": "metric.type=\"logging.googleapis.com/user/sweep_checked_count\" resource.type=\"cloud_run_revision\""
                  }
                }
              }
            ],
            "yAxis": {
              "label": "VMs",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "yPos": 92,
        "xPos": 16,
        "width": 16,
        "height": 16,
        "widget": {
          "title": "Sweep deleted (VMs removed per run)",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "minAlignmentPeriod": "3600s",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "3600s",
                      "crossSeriesReducer": "REDUCE_MEAN",
                      "perSeriesAligner": "ALIGN_PERCENTILE_50"
                    },
                    "filter": "metric.type=\"logging.googleapis.com/user/sweep_deleted_count\" resource.type=\"cloud_run_revision\""
                  }
                }
              }
            ],
            "yAxis": {
              "label": "VMs",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "yPos": 92,
        "xPos": 32,
        "width": 16,
        "height": 16,
        "widget": {
          "title": "Sweep errors per run",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "minAlignmentPeriod": "3600s",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "3600s",
